# Salin ke backend/.env lalu sesuaikan. JANGAN commit .env.

# development | production
NARADIG_ENV=development

# WAJIB diganti di produksi (validasi startup akan menolak nilai default).
NARADIG_SECRET=dev-secret-ganti-di-produksi

# SQLite (default). Untuk Supabase/PostgreSQL isi DATABASE_URL dan biarkan kosong bila SQLite.
NARADIG_DB=naradig.db
DATABASE_URL=

# Backup
NARADIG_BACKUP_DIR=backups
NARADIG_BACKUP_KEEP_DAYS=7

# Supabase Storage (opsional; backup lokal tetap jalan tanpa ini)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=naradig-backups

# Queue (opsional; kosong = eksekusi inline)
REDIS_URL=

# Feed nyata dipisah koma. Kosongkan untuk memakai korpus demo.
NARADIG_RSS_FEEDS=https://www.antaranews.com/rss/terkini.xml,https://www.cnnindonesia.com/rss
NARADIG_FACTCHECK_FEEDS=https://turnbackhoax.id/feed/,https://cekfakta.com/feed/
# Scraper HTML portal berita (tanpa API key): antara, cnbc, detik, suara, liputan6
NARADIG_SCRAPE_SITES=antara,cnbc,detik,suara,liputan6
# Artikel per situs per eksekusi (jeda 0,4 s antar artikel)
NARADIG_SCRAPE_MAX=6
# false = jangan fallback ke korpus demo (hanya data feed nyata)
NARADIG_ALLOW_MOCK=true
# Ambang cosine TF-IDF (0.25 cocok untuk deskripsi RSS pendek)
NARADIG_SIM_THRESHOLD=0.25

# CORS (pisahkan koma)
CORS_ORIGINS=http://localhost:3000

# Zona waktu label di API
NARADIG_TZ=Asia/Makassar